import 'package:flutter/material.dart';

/// Dodo Live design tokens — palette.
///
/// Direction: "midnight arcade" — a deep violet-black stage that makes
/// streamed video the brightest thing on screen, with a warm gold accent
/// for value/rewards and a hot-magenta accent for live/energy moments.
/// Avoids the generic near-black + single neon accent look by pairing two
/// warm/cool accents against a tinted (not flat) dark surface.
class AppColors {
  AppColors._();

  // Base surfaces
  static const Color stage = Color(0xFF0C0A14); // app background, the "stage"
  static const Color surface = Color(0xFF161225); // cards, sheets
  static const Color surfaceRaised = Color(0xFF1F1A33); // elevated surfaces
  static const Color surfaceLine = Color(0xFF2A2440); // hairlines/dividers

  // Accents
  static const Color gold = Color(0xFFE8B54D); // rewards, coins, premium
  static const Color goldDeep = Color(0xFFB8842E);
  static const Color magenta = Color(0xFFFF3D7F); // live, PK battle, energy
  static const Color magentaDeep = Color(0xFFC91E5C);
  static const Color violet = Color(0xFF8B5CF6); // secondary accent, gifts
  static const Color teal = Color(0xFF2FE6C4); // success, online, coins-earned

  // PK battle team colors
  static const Color pkBlue = Color(0xFF3D8BFF);
  static const Color pkRed = Color(0xFFFF4D4D);

  // Text
  static const Color textPrimary = Color(0xFFF6F3FF);
  static const Color textSecondary = Color(0xFFAFA6C7);
  static const Color textMuted = Color(0xFF716A8C);

  // Status
  static const Color liveRed = Color(0xFFFF3D5A);
  static const Color success = Color(0xFF2FE6C4);
  static const Color warning = Color(0xFFE8B54D);
  static const Color danger = Color(0xFFFF4D4D);

  static const LinearGradient goldGradient = LinearGradient(
    colors: [Color(0xFFF7D488), gold, goldDeep],
    begin: Alignment.topLeft,
    end: Alignment.bottomRight,
  );

  static const LinearGradient liveGradient = LinearGradient(
    colors: [magenta, violet],
    begin: Alignment.centerLeft,
    end: Alignment.centerRight,
  );

  static const LinearGradient pkGradient = LinearGradient(
    colors: [pkBlue, pkRed],
    begin: Alignment.centerLeft,
    end: Alignment.centerRight,
  );

  static const RadialGradient stageGlow = RadialGradient(
    colors: [Color(0xFF241D3D), stage],
    center: Alignment.topCenter,
    radius: 1.2,
  );
}
